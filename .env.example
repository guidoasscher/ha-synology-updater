# ==============================================================================
# Application Language (en = English [default], nl = Nederlands)
# ==============================================================================
APP_LANGUAGE=en

# ==============================================================================
# Synology NAS & SSH Configuration (DSM 7.1)
# ==============================================================================
NAS_IP=192.168.1.100
SSH_PORT=22
SSH_USER=your_ssh_user
SSH_KEY_PATH=C:\Users\your_user\.ssh\id_ed25519

# Optional: SSH password (or SSH key passphrase) and sudo support.
# Leave SSH_PASSWORD empty when using an unencrypted Ed25519 key + docker group / NOPASSWD.
SSH_PASSWORD=
USE_SUDO=false

# Optional: Enforce strict SSH host key verification via ~/.ssh/known_hosts (true / false)
SSH_STRICT_HOST_KEY=false

# ==============================================================================
# Paths & Docker Configuration
# ==============================================================================
# Windows SMB/UNC path (or mapped drive) pointing to the shared Docker folder on the NAS:
SMB_PATH=\\192.168.1.100\docker\ha_latest.tar

# Corresponding local Linux path on the Synology NAS itself:
NAS_TAR_PATH=/volume1/docker/ha_latest.tar

# Path to the Docker binary on Synology DSM 7.1:
NAS_DOCKER_BIN=/usr/local/bin/docker

# ==============================================================================
# Home Assistant Image & Container Settings
# ==============================================================================
IMAGE_NAME=homeassistant/home-assistant:latest
IMAGE_PLATFORM=linux/amd64

# Name of the running Home Assistant container on the Synology NAS:
HA_CONTAINER_NAME=home-assistant

# Automatically recreate and restart the running container once 'docker load' finishes?
AUTO_RECREATE_CONTAINER=true

# Container recreation method:
# - inspect  : (Recommended) Reads all settings (volumes, host network, USB devices, env)
#              from the existing container, renames the old container as a backup, starts
#              the new container on the latest image, and rolls back automatically on failure.
# - compose  : Runs 'docker-compose up -d' using NAS_COMPOSE_PATH.
RECREATE_MODE=inspect

# Only required when RECREATE_MODE=compose:
NAS_COMPOSE_PATH=/volume1/docker/homeassistant/docker-compose.yml

# ==============================================================================
# Logging (Rotating log file: max 5 MB x 3 backups)
# ==============================================================================
LOG_FILE=ha_update.log
